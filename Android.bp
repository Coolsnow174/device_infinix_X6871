    vendor: true,
    installed_location: "firmware/sensor",
    symlink_target: "/vendor/etc/imgsensor/mt6895",
}
install_symlink {
    name: "x6871_mdota_link",
    vendor: true,
    installed_location: "etc/mdota",
    symlink_target: "/mnt/vendor/mdota",
}
