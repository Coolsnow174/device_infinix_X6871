BOARD_AVB_ODM_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.odm.fingerprint:x

BOARD_AVB_ODM_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_ODM_ALGORITHM := SHA256_RSA2048
BOARD_AVB_ODM_ROLLBACK_INDEX := 1
BOARD_AVB_ODM_ROLLBACK_INDEX_LOCATION := 9

BOARD_AVB_ODM_DLKM_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.odm_dlkm.fingerprint:x

BOARD_AVB_ODM_DLKM_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_ODM_DLKM_ALGORITHM := SHA256_RSA2048
BOARD_AVB_ODM_DLKM_ROLLBACK_INDEX := 1
BOARD_AVB_ODM_DLKM_ROLLBACK_INDEX_LOCATION := 10

BOARD_AVB_PRODUCT_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.product.fingerprint:x

BOARD_AVB_PRODUCT_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_PRODUCT_ALGORITHM := SHA256_RSA2048
BOARD_AVB_PRODUCT_ROLLBACK_INDEX := 1
BOARD_AVB_PRODUCT_ROLLBACK_INDEX_LOCATION := 11

BOARD_AVB_SYSTEM_EXT_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.system_ext.fingerprint:x

BOARD_AVB_SYSTEM_EXT_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_SYSTEM_EXT_ALGORITHM := SHA256_RSA2048
BOARD_AVB_SYSTEM_EXT_ROLLBACK_INDEX := 1
BOARD_AVB_SYSTEM_EXT_ROLLBACK_INDEX_LOCATION := 12

BOARD_AVB_SYSTEM_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.system.fingerprint:x

BOARD_AVB_SYSTEM_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_SYSTEM_ALGORITHM := SHA256_RSA2048
BOARD_AVB_SYSTEM_ROLLBACK_INDEX := 1
BOARD_AVB_SYSTEM_ROLLBACK_INDEX_LOCATION := 13

BOARD_AVB_SYSTEM_DLKM_ADD_HASH_FOOTER_ARGS := \
    --prop com.android.build.system_dlkm.fingerprint:x

BOARD_AVB_SYSTEM_DLKM_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
BOARD_AVB_SYSTEM_DLKM_ALGORITHM := SHA256_RSA2048
BOARD_AVB_SYSTEM_DLKM_ROLLBACK_INDEX := 1
BOARD_AVB_SYSTEM_DLKM_ROLLBACK_INDEX_LOCATION := 14

BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --padding_size 4096

# Platform
TARGET_BOARD_PLATFORM := mt6895
BOARD_HAS_MTK_HARDWARE := true

# SEPolicy
include device/mediatek/sepolicy_vndr/SEPolicy.mk
BUILD_BROKEN_VENDOR_PROPERTY_NAMESPACE := true
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/public
BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor

# Firmware (radio partitions; images live in the X6871-kernel tree)
FIRMWARE_PATH := $(KERNEL_PATH)/firmware

# Only include radio partitions whose images are actually present
FW_AVAILABLE := $(foreach img, dpm gz lk logo mcupm md1img pi_img scp spmfw sspm tee tkv, $(if $(wildcard $(FIRMWARE_PATH)/$(img).img), $(img)))

ifneq (,$(FW_AVAILABLE))
AB_OTA_PARTITIONS += $(FW_AVAILABLE)
endif

BOARD_CUSTOMIMAGES_PARTITION_LIST := $(FW_AVAILABLE)

ifneq (,$(wildcard $(FIRMWARE_PATH)/dpm.img))
BOARD_DPM_IMAGE_LIST := $(FIRMWARE_PATH)/dpm.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/gz.img))
BOARD_GZ_IMAGE_LIST := $(FIRMWARE_PATH)/gz.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/lk.img))
BOARD_LK_IMAGE_LIST := $(FIRMWARE_PATH)/lk.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/logo.img))
BOARD_LOGO_IMAGE_LIST := $(FIRMWARE_PATH)/logo.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/mcupm.img))
BOARD_MCUPM_IMAGE_LIST := $(FIRMWARE_PATH)/mcupm.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/md1img.img))
BOARD_MD1IMG_IMAGE_LIST := $(FIRMWARE_PATH)/md1img.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/pi_img.img))
BOARD_PI_IMG_IMAGE_LIST := $(FIRMWARE_PATH)/pi_img.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/scp.img))
BOARD_SCP_IMAGE_LIST := $(FIRMWARE_PATH)/scp.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/spmfw.img))
BOARD_SPMFW_IMAGE_LIST := $(FIRMWARE_PATH)/spmfw.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/sspm.img))
BOARD_SSPM_IMAGE_LIST := $(FIRMWARE_PATH)/sspm.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/tee.img))
BOARD_TEE_IMAGE_LIST := $(FIRMWARE_PATH)/tee.img
endif
ifneq (,$(wildcard $(FIRMWARE_PATH)/tkv.img))
BOARD_TKV_IMAGE_LIST := $(FIRMWARE_PATH)/tkv.img
endif

# UFFD
PRODUCT_ENABLE_UFFD_GC := true

# Allow duplicate prebuilt rules (Transsion/MTK vendors)
BUILD_BROKEN_DUP_SYSPROP := true
BUILD_BROKEN_INCORRECT_PARTITION_IMAGES := true

# Prebuilt ELF checks
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true

# Inherit the proprietary files
include vendor/infinix/X6871/BoardConfigVendor.mk
