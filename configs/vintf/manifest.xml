<!--
    Device manifest for the Infinix GT 20 Pro (X6871) running Android 16 (XOS 16.3).

    The stock XOS 16.3 build is a fully AIDL-based vendor: there is not a single
    HIDL HAL left in vendor/etc/vintf. The manifest below therefore mirrors the
    vendor manifests 1:1 so that the vendor and platform VINTF stay compatible.
-->
<manifest version="9.0" type="device" target-level="202504">

    <!--
        Platform AIDL HALs. These are provided by the platform and the vendor
        blobs; the device manifest only has to declare them so that the
        framework can bind to them.
    -->
