# X6871 device-specific init additions.
# Installed to /vendor/etc/init and imported automatically by init.

# FTS double-tap-to-wake. /proc/gesture_function is created by the touch
# driver; arm it once at boot (the power HAL hint updates it after that).
on boot
    write /proc/gesture_function cc1

# AOSP zram swap setup (mirrors the stock MTK power init rc timing).
on post-fs-data
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 50
    write /sys/kernel/mm/swap/vma_ra_enabled true
    swapon_all /vendor/etc/fstab.zram
